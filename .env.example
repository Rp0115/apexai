# Copy to .env and fill in values (.env is gitignored)
# cp .env.example .env   (or copy manually on Windows)

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Use AI profile automatically (chat + embeddings + pgvector)
SPRING_PROFILES_ACTIVE=ai

# Let Spring Boot manage compose.yaml postgres (set false inside Docker)
DOCKER_COMPOSE_ENABLED=true
